# ── SecureID Backend Environment Variables ──
# Copy this file to .env and fill in real values before running.

# Flask
FLASK_ENV=development
PORT=5000

# JWT — generate a strong random secret for production
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# AES encryption key for sensitive fields (DOB, address)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_KEY=CHANGE_ME_BEFORE_PRODUCTION

# CORS — restrict to frontend origin
CORS_ORIGIN=http://localhost:5173
